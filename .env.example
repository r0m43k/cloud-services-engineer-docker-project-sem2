APP_ENV=production

FRONTEND_IMAGE=frontend:latest
BACKEND_IMAGE=backend:latest

FRONTEND_HOST_PORT=80
BACKEND_HOST_PORT=8081
BACKEND_CONTAINER_PORT=8081

VUE_APP_API_URL=http://localhost:8081

FRONTEND_MEMORY=128m
BACKEND_MEMORY=256m
PROXY_MEMORY=128m

FRONTEND_CPU=0.25
BACKEND_CPU=0.50
PROXY_CPU=0.25

APP_SECRET_FILE=./secrets/secrets.example
